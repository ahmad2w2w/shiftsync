# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (alleen nodig voor betaalde abonnementen)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# De volgende keys worden alleen gebruikt in Supabase Edge Functions (niet in de browser)
# Voeg ze toe via: supabase secrets set STRIPE_SECRET_KEY=...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@jouwdomein.nl
# SUPABASE_SERVICE_ROLE_KEY=...  (automatisch beschikbaar in Edge Functions)
